generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  RIGHTS_MANAGER
  SUPPORT_AGENT
  VIEWER
}

enum EventStatus {
  SCHEDULED
  LIVE
  PAUSED
  DELAYED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum StreamStatus {
  IDLE
  INGESTING
  LIVE
  ERROR
  OFFLINE
}

enum ContentType {
  LIVE
  REPLAY
  HIGHLIGHT
  CLIP
  ARCHIVE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  TRIAL
  GRACE
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  MOCK
  MTN_MOMO
  AIRTEL_MONEY
  STRIPE
}

enum RightsContentType {
  LIVE
  REPLAY
  HIGHLIGHT
  CLIP
  ALL
}

// Core Auth & Users
model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  emailVerified         Boolean  @default(false)
  emailVerificationToken String? @db.VarChar(255)
  passwordHash          String   @db.VarChar(255)
  firstName             String?  @db.VarChar(100)
  lastName              String?  @db.VarChar(100)
  displayName           String?  @db.VarChar(100)
  avatarUrl             String?
  role                  UserRole @default(VIEWER)
  countryCode           String?  @db.VarChar(2)
  language              String   @default("en") @db.VarChar(10)
  timezone              String   @default("UTC") @db.VarChar(64)
  isActive              Boolean  @default(true)
  isBlocked             Boolean  @default(false)
  twoFactorEnabled      Boolean  @default(false)
  twoFactorSecret       String?  @db.VarChar(255)
  lastLoginAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  refreshTokens         RefreshToken[]
  sessions              UserSession[]
  auditLogs             AuditLog[]    @relation("AuditActor")
  favorites             Favorite[]
  subscriptions         Subscription[]
  orders                Order[]
  entitlements          Entitlement[]
  playbackSessions      PlaybackSession[]
  notificationPrefs     NotificationPreference?

  @@index([role])
  @@index([countryCode])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique @db.VarChar(255)
  familyId    String   @db.VarChar(100)
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([familyId])
}

model UserSession {
  id          String   @id @default(uuid())
  userId      String
  deviceInfo  String?  @db.VarChar(255)
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  lastActiveAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String   @db.VarChar(100)
  entity      String   @db.VarChar(100)
  entityId    String?  @db.VarChar(100)
  metadata    Json?
  ipAddress   String?  @db.VarChar(45)
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId])
  @@index([entity, entityId])
}

// Sports Catalogue (Generic)
model Sport {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  category    String?  @db.VarChar(100)
  isTeamBased Boolean  @default(true)
  scoringType String?  @db.VarChar(100)
  iconUrl     String?
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competitions Competition[]
  events       Event[]

  @@index([isActive])
}

model Organization {
  id        String   @id @default(uuid())
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(150)
  type      String?  @db.VarChar(50)
  countryCode String? @db.VarChar(2)
  logoUrl   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitions Competition[]
}

model Competition {
  id             String   @id @default(uuid())
  slug           String   @unique @db.VarChar(150)
  name           String   @db.VarChar(150)
  sportId        String
  organizationId String?
  level          String   @db.VarChar(50)
  countryCode    String?  @db.VarChar(2)
  logoUrl        String?
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sport        Sport         @relation(fields: [sportId], references: [id], onDelete: Restrict)
  organization Organization?  @relation(fields: [organizationId], references: [id])
  seasons      Season[]
  events       Event[]

  @@index([sportId])
  @@index([isActive])
}

model Season {
  id            String   @id @default(uuid())
  competitionId String
  name          String   @db.VarChar(100)
  slug          String   @db.VarChar(150)
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  isActive      Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  stages      CompetitionStage[]
  events      Event[]

  @@unique([competitionId, slug])
  @@index([isActive])
}

model CompetitionStage {
  id       String   @id @default(uuid())
  seasonId String
  name     String   @db.VarChar(100)
  slug     String   @db.VarChar(100)
  order    Int      @default(0)
  type     String?  @db.VarChar(50)
  metadata Json?
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([seasonId, slug])
}

model Venue {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  city        String?  @db.VarChar(100)
  countryCode String?  @db.VarChar(2)
  capacity    Int?
  timezone    String?  @db.VarChar(64)
  latitude    Float?
  longitude   Float?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]
}

model Team {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(150)
  name        String   @db.VarChar(150)
  shortName   String?  @db.VarChar(50)
  countryCode String?  @db.VarChar(2)
  logoUrl     String?
  isNational  Boolean  @default(false)
  sportId     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rosters     Roster[]
  homeEvents  EventParticipant[] @relation("TeamParticipant")
  // generic
  @@index([countryCode])
}

model Athlete {
  id          String   @id @default(uuid())
  slug        String   @unique @db.VarChar(150)
  firstName   String   @db.VarChar(100)
  lastName    String   @db.VarChar(100)
  displayName String?  @db.VarChar(150)
  countryCode String?  @db.VarChar(2)
  dateOfBirth DateTime? @db.Date
  gender      String?  @db.VarChar(20)
  photoUrl    String?
  sportId     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rosters     Roster[]
  participants EventParticipant[] @relation("AthleteParticipant")

  @@index([countryCode])
}

model Roster {
  id        String   @id @default(uuid())
  teamId    String
  athleteId String
  seasonId  String?
  jerseyNumber String? @db.VarChar(10)
  position  String?  @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([teamId, athleteId, seasonId])
}

model Event {
  id            String      @id @default(uuid())
  slug          String      @unique @db.VarChar(200)
  title         String      @db.VarChar(250)
  sportId       String
  competitionId String?
  seasonId      String?
  stageId       String?
  venueId       String?
  status        EventStatus @default(SCHEDULED)
  scheduledAt   DateTime
  startedAt     DateTime?
  endedAt       DateTime?
  timezone      String      @default("UTC") @db.VarChar(64)
  isPublished   Boolean     @default(false)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sport       Sport             @relation(fields: [sportId], references: [id], onDelete: Restrict)
  competition Competition?      @relation(fields: [competitionId], references: [id])
  season      Season?           @relation(fields: [seasonId], references: [id])
  stage       CompetitionStage? @relation(fields: [stageId], references: [id])
  venue       Venue?            @relation(fields: [venueId], references: [id])

  participants EventParticipant[]
  results      EventResult[]
  streams      EventStream[]
  videoAssets  VideoAsset[]

  @@index([sportId])
  @@index([competitionId])
  @@index([status])
  @@index([scheduledAt])
  @@index([isPublished])
}

model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  teamId    String?
  athleteId String?
  role      String   @default("COMPETITOR") @db.VarChar(50)
  seed      Int?
  lane      Int?
  metadata  Json?
  createdAt DateTime @default(now())

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team    Team?    @relation("TeamParticipant", fields: [teamId], references: [id])
  athlete Athlete? @relation("AthleteParticipant", fields: [athleteId], references: [id])

  @@unique([eventId, teamId, athleteId, role])
  @@index([eventId])
}

model EventResult {
  id          String   @id @default(uuid())
  eventId     String
  participantId String?
  position    Int?
  score       Json?
  isWinner    Boolean  @default(false)
  isDisqualified Boolean @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Streaming & Video
model Stream {
  id              String       @id @default(uuid())
  slug            String       @unique @db.VarChar(150)
  name            String       @db.VarChar(150)
  provider        String       @db.VarChar(50)
  ingestUrl       String?
  playbackBaseUrl String?
  status          StreamStatus @default(IDLE)
  isActive        Boolean      @default(true)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  eventStreams EventStream[]
}

model EventStream {
  id        String   @id @default(uuid())
  eventId   String
  streamId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@unique([eventId, streamId])
}

model VideoAsset {
  id            String      @id @default(uuid())
  eventId       String?
  title         String      @db.VarChar(250)
  slug          String      @unique @db.VarChar(200)
  type          ContentType
  provider      String      @db.VarChar(50)
  providerAssetId String?   @db.VarChar(200)
  durationSec   Int?
  thumbnailUrl  String?
  hlsUrl        String?
  dashUrl       String?
  isPublished   Boolean     @default(false)
  publishAt     DateTime?
  unpublishAt   DateTime?
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  event Event? @relation(fields: [eventId], references: [id])

  @@index([type])
  @@index([isPublished])
}

// Rights
model Territory {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(10)
  name        String   @db.VarChar(100)
  region      String?  @db.VarChar(50)
  createdAt   DateTime @default(now())

  rights      ContentRight[]
}

model RightsAgreement {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(200)
  holderName    String   @db.VarChar(150)
  distributor   String?  @db.VarChar(150)
  startDate     DateTime
  endDate       DateTime
  isExclusive   Boolean  @default(false)
  status        String   @default("ACTIVE") @db.VarChar(20)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentRights ContentRight[]

  @@index([status])
  @@index([startDate, endDate])
}

model ContentRight {
  id               String            @id @default(uuid())
  agreementId      String
  territoryId      String
  sportId          String?
  competitionId    String?
  seasonId         String?
  eventId          String?
  videoAssetId     String?
  contentType      RightsContentType
  isAllowed        Boolean           @default(true)
  blackoutStart    DateTime?
  blackoutEnd      DateTime?
  maxDevices       Int?
  maxConcurrency   Int?
  createdAt        DateTime          @default(now())

  agreement RightsAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  territory Territory       @relation(fields: [territoryId], references: [id], onDelete: Restrict)

  @@index([territoryId])
  @@index([agreementId])
}

// Subscriptions & Payments
model SubscriptionPlan {
  id            String   @id @default(uuid())
  slug          String   @unique @db.VarChar(100)
  name          String   @db.VarChar(150)
  description   String?
  sportId       String?
  competitionId String?
  interval      String   @db.VarChar(20)
  priceCents    Int
  currency      String   @default("USD") @db.VarChar(10)
  isActive      Boolean  @default(true)
  features      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String
  planId     String
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime
  endDate    DateTime?
  renewsAt   DateTime?
  cancelledAt DateTime?
  metadata   Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  planId          String?
  eventId         String?
  type            String      @db.VarChar(50)
  status          OrderStatus @default(PENDING)
  amountCents     Int
  currency        String      @default("USD") @db.VarChar(10)
  provider        PaymentProvider @default(MOCK)
  providerOrderId String?     @db.VarChar(200)
  promoCode       String?     @db.VarChar(50)
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id              String   @id @default(uuid())
  orderId         String
  provider        PaymentProvider
  providerPaymentId String? @db.VarChar(200)
  amountCents     Int
  currency        String   @db.VarChar(10)
  status          String   @db.VarChar(30)
  rawCallback     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Entitlement {
  id        String   @id @default(uuid())
  userId    String
  planId    String?
  eventId   String?
  type      String   @db.VarChar(50)
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// Playback
model PlaybackSession {
  id           String   @id @default(uuid())
  userId       String?
  eventId      String?
  videoAssetId String?
  tokenJti     String   @unique @db.VarChar(100)
  ipAddress    String?  @db.VarChar(45)
  deviceId     String?  @db.VarChar(100)
  countryCode  String?  @db.VarChar(2)
  isActive     Boolean  @default(true)
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  lastHeartbeatAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isActive])
}

// Favorites, Notifications, Analytics
model Favorite {
  id         String   @id @default(uuid())
  userId     String
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(100)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
}

model NotificationPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  emailEnabled      Boolean  @default(true)
  pushEnabled       Boolean  @default(true)
  eventReminders    Boolean  @default(true)
  favoriteTeamAlerts Boolean @default(true)
  marketing         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(200)
  body      String?
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventId   String?
  type      String   @db.VarChar(50)
  value     Float?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}